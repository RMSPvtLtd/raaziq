# Copy to .env and adjust. .env is never committed.

# "production" enables startup safety checks (backend/config.py::
# assert_production_ready): the app REFUSES TO START if JWT_SECRET_KEY or
# OPS_ADMIN_PASSWORD is still a development default, if the signing key is
# under 32 characters, or if CORS_ORIGINS is empty or contains "*". It also
# disables /docs, /redoc and /openapi.json, and enables HSTS.
ENVIRONMENT=development

# PostgreSQL in production. The test suite ignores this and uses its own SQLite file.
# Use a least-privilege role: the app needs DML on its own tables, not
# superuser. Never expose the database publicly.
DATABASE_URL=postgresql+psycopg://raaziq:raaziq@localhost:5432/raaziq

# Pricing
DEFAULT_MARKUP_PERCENT=20
QUOTE_VALIDITY_DAYS=14

# Volumetric (dimensional) weight factors, kg per CBM.
VOLUMETRIC_FACTOR_AIR=167
VOLUMETRIC_FACTOR_SEA=1000
VOLUMETRIC_FACTOR_ROAD=333

# Job numbers, e.g. RAZ-2026-00001
JOB_NUMBER_PREFIX=RAZ
JOB_NUMBER_PADDING=5

# Invoice numbers, e.g. INV-2026-00001
INVOICE_NUMBER_PREFIX=INV
INVOICE_NUMBER_PADDING=5

# Comma-separated origins allowed to call the API from a browser. Explicit
# origins only -- "*" is rejected in production (credentialed API).
CORS_ORIGINS=http://localhost:5173

# Signs worker/customer/ops login tokens. CHANGE THIS before deploying
# anywhere real: a known signing key means anyone can forge a token for any
# account. Production refuses to boot with this default or with <32 chars.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_EXPIRY_MINUTES=720

# Failed-login throttling, per (account + client IP). In-process only, so on
# a multi-instance/serverless deployment the effective limit is per instance
# -- see the security report's "remaining risks".
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

# Bootstrap credential for the single OpsUser the seed script creates. TEMPORARY DEV
# CREDENTIAL -- change it via POST /ops/change-password before any real deployment.
# Production refuses to boot while this is still the default.
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=ChangeMe123!

# Gmail sender account with 2-Step Verification and an app password.
# Leave credentials empty to disable delivery during development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Optional default recipient. Company settings override this; if both are
# empty, each document goes to its customer's email address.
NOTIFICATION_EMAIL=
# Existing Resend deployments remain supported when SMTP is not configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Raaziq International <onboarding@resend.dev>
